# ====================================================================
# Covai Machines Expense Management System - Environment Variables
# ====================================================================

# 1. Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous (Public) API Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Note:
# - These variables are OPTIONAL. If left empty, the app will run seamlessly
#   using the browser's persistent Local Storage.
# - You can also configure them directly in the UI under Settings (⚙️).
